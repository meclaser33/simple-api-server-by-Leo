				"type": "text/javascript",
				"packages": {},
				"requests": {},
				"exec": [
					"pm.test(\"응답 데이터가 iterationData와 완전히 일치한다\", function () {\r",
					"\r",
					"  // 1️⃣ 서버 응답 Body를 JSON 객체로 파싱\r",
					"  // GET /posts/1 이므로 배열이 아니라 객체임\r",
					"  const responseData = pm.response.json();\r",
					"\r",
					"  // 2️⃣ Collection Runner에 업로드한 JSON 파일에서\r",
					"  // 현재 iteration의 값들을 가져옴\r",
					"  //\r",
					"  // iterationData는 \"한 row\" 기준이라\r",
					"  // 배열이 아닌 객체 형태로 접근함\r",
					"  const expectedData = {\r",
					"    userId: pm.iterationData.get(\"userId\"),\r",
					"    id: pm.iterationData.get(\"id\"),\r",
					"    title: pm.iterationData.get(\"title\"),\r",
					"    body: pm.iterationData.get(\"body\")\r",
					"  };\r",
					"\r",
					"  // 3️⃣ 응답 데이터와 iterationData를 깊은 비교(eql)\r",
					"  // 값 + 타입까지 전부 동일해야 통과\r",
					"  pm.expect(responseData).to.eql(expectedData);\r",
					"});"
				]
			}
		}
	]
